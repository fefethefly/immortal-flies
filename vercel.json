{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/blueprint", "destination": "/blueprint.html" }
  ],
  "redirects": [
    { "source": "/altar", "destination": "/blueprint", "permanent": false },
    { "source": "/altar.html", "destination": "/blueprint.html", "permanent": false },
    { "source": "/economy", "destination": "/blueprint", "permanent": false },
    { "source": "/economy.html", "destination": "/blueprint.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/token/official.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    }
  ]
}
