{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/blueprint", "destination": "/blueprint.html" },
    { "source": "/economy", "destination": "/economy.html" },
    { "source": "/habitat", "destination": "/habitat.html" },
    { "source": "/host", "destination": "/host.html" },
    { "source": "/market", "destination": "/market.html" },
    { "source": "/colony", "destination": "/colony.html" },
    { "source": "/field", "destination": "/field.html" },
    { "source": "/swarm", "destination": "/swarm.html" },
    { "source": "/brain", "destination": "/brain.html" },
    { "source": "/protocol", "destination": "/protocol.html" },
    { "source": "/docs", "destination": "/docs.html" }
  ],
  "redirects": [
    { "source": "/altar", "destination": "/blueprint", "permanent": false },
    {
      "source": "/altar.html",
      "destination": "/blueprint.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/token/official.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    },
    {
      "source": "/contract/life/ImmortalSoul.deployment.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/contract/life/SoulMarket.deployment.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/contract/life/SoulMarket.testnet.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/contract/life/MiningHub.deployment.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/contract/life/MiningHub.testnet.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/contract/life/PrivateRunner.deployment.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/contract/life/PrivateRunner.testnet.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/life-genesis/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
