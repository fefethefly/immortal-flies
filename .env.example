# Immortal Flyswarm API (local). Copy to .env and fill secrets. Never commit real keys.

# BSC testnet deployer for ImmortalSoul. Needs tBNB. Never commit the key.
# IFF_DEPLOY_KEY=0x
# BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
# Optional hive for testnet SoulKinFee / SoulMarket. Defaults to the deployer.
# IFF_TESTNET_HIVE=0x
# Mainnet deploy / curator actions. Do not reuse the testnet key.
# IFS_MAINNET_DEPLOY_KEY=0x
# BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# Testnet private-track runner (Railway / local). Never commit the key.
# IFF_CHAIN_ID=97
# IFF_RUNNER_TOKENS=1
# IFF_RUNNER_STEPS=1000
# IFF_GRAPH_DIR=./public/data/malecns-full
# IFF_DATA_DIR=./server/data/runner
# IFF_PUBLIC_BASE=https://your-service.up.railway.app
# IFF_MIRROR_DIR=./server/data/runner-mirror
# IFF_ARCHIVE_RETAIN_MS=3196800000

# Dedicated mainnet runner. Do not reuse the testnet process or IFF_DATA_DIR.
# IFF_CHAIN_ID=56
# IFF_MAINNET_RUNNER=1
# IFF_DATA_DIR=./server/data/runner-mainnet
# IFF_MIRROR_DIR=./server/data/runner-mainnet-mirror
# IFF_HUB_LISTING=public/contract/life/MiningHub.deployment.json


PORT=8787
IFF_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
IFF_DATA_DIR=./server/data
IFF_GRAPH_DIR=./public/data/malecns-circuit

# OpenAI-compatible provider (DeepSeek default). Leave API key empty for degraded local explainer.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Session lifetime (ms). Idle evicts memory (lazy-load from disk); max age deletes the archive.
IFF_SESSION_IDLE_MS=7200000
IFF_SESSION_MAX_AGE_MS=86400000
IFF_SESSION_MAX_LIVE=64

# Rate limits. 0 disables a bucket.
IFF_RATE_TICK_PER_SEC=8
IFF_RATE_WRITE_PER_MIN=60
IFF_RATE_LLM_PER_MIN=20
IFF_RATE_CREATE_PER_MIN=20

# Venue quotes (KyberSwap BSC, read-only). Default ON. Fills stay paper SIM.
# Set to 0/false/off to disable the server poller. The static site still
# fetches Kyber GET /routes from the browser.
# IFF_VENUE_ENABLED=0
# IFF_VENUE_POLL_MS=3000
# IFF_VENUE_STALE_MS=15000
# IFF_KYBER_CLIENT_ID=immortalflies
# IFF_VENUE_WATCHLIST=./public/token/venue-watchlist.json
