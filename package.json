{
  "name": "immortal-fruit-flies",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server/src/index.mjs",
    "server:dev": "node --watch server/src/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "connectome:prepare": "python3 scripts/data/prepare_malecns.py",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:test": "node scripts/test-contracts.mjs",
    "contracts:check:testnet": "node scripts/deploy-testnet.mjs --check",
    "contracts:deploy:testnet": "node scripts/deploy-testnet.mjs",
    "life:compile": "node scripts/compile-life.mjs",
    "life:test": "node scripts/test-life.mjs",
    "life:genesis": "node scripts/build-life-genesis.mjs",
    "life:field": "node scripts/build-life-field.mjs",
    "life:phenotype": "node scripts/build-life-phenotype.mjs",
    "life:check:testnet": "node scripts/deploy-life-testnet.mjs --check",
    "life:deploy:testnet": "node scripts/deploy-life-testnet.mjs",
    "life:hatch:testnet": "node scripts/hatch-life-testnet.mjs",
    "life:check:mainnet": "node scripts/deploy-life-mainnet.mjs --check",
    "life:deploy:mainnet": "node scripts/deploy-life-mainnet.mjs",
    "life:check:kin-fee": "node scripts/deploy-soulkin-fee.mjs --check",
    "life:deploy:kin-fee:testnet": "node scripts/deploy-soulkin-fee.mjs",
    "life:check:market": "node scripts/deploy-soul-market.mjs --check",
    "life:deploy:market:testnet": "node scripts/deploy-soul-market.mjs",
    "flap:prepare": "node scripts/flap-launch.mjs",
    "format": "prettier --write src tests scripts server index.html README.md DESIGN.md docs"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "vite": "6.4.2"
  }
}
