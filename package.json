{
  "name": "immortal-fruit-flies",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://immortalflies.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fefethefly/immortal-flies.git"
  },
  "bugs": {
    "url": "https://github.com/fefethefly/immortal-flies/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server/src/index.mjs",
    "server:dev": "node --watch server/src/index.mjs",
    "pit:runner": "node server/src/pit-runner/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "segment:replay": "node scripts/segment-replay.mjs verify",
    "segment:replay:full": "SEGMENT_REPLAY_FULL=1 node --test tests/segment-replay.test.mjs",
    "connectome:prepare": "python3 scripts/data/prepare_malecns.py",
    "connectome:ensure:full": "node scripts/ensure-malecns-full.mjs",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:test": "node scripts/test-contracts.mjs",
    "contracts:check:testnet": "node scripts/deploy-testnet.mjs --check",
    "contracts:deploy:testnet": "node scripts/deploy-testnet.mjs",
    "life:compile": "node scripts/compile-life.mjs",
    "life:test": "node scripts/test-life.mjs",
    "life:test:hub": "node scripts/test-mining-hub.mjs",
    "life:check:hub": "node scripts/deploy-mining-hub.mjs --check",
    "life:deploy:hub:testnet": "node scripts/deploy-mining-hub.mjs",
    "life:wire:hub:testnet": "node scripts/wire-mining-hub-testnet.mjs",
    "segment:compare": "node scripts/segment-verify-compare.mjs",
    "runner:testnet": "IFF_CHAIN_ID=97 node server/src/runner/index.mjs",
    "runner:mainnet": "IFF_CHAIN_ID=56 IFF_MAINNET_RUNNER=1 node server/src/runner/index.mjs",
    "life:restore": "node scripts/restore-life.mjs",
    "life:genesis": "node scripts/build-life-genesis.mjs",
    "life:field": "node scripts/build-life-field.mjs",
    "life:phenotype": "node scripts/build-life-phenotype.mjs",
    "life:check:testnet": "node scripts/deploy-life-testnet.mjs --check",
    "life:deploy:testnet": "node scripts/deploy-life-testnet.mjs",
    "life:hatch:testnet": "node scripts/hatch-life-testnet.mjs",
    "life:check:mainnet": "node scripts/deploy-life-mainnet.mjs --check",
    "life:deploy:mainnet": "node scripts/deploy-life-mainnet.mjs",
    "life:check:kin-fee": "node scripts/deploy-soulkin-fee.mjs --check",
    "life:check:kin-cross": "node scripts/deploy-soulkin-cross.mjs --check",
    "life:deploy:kin-fee:testnet": "node scripts/deploy-soulkin-fee.mjs",
    "life:deploy:kin-cross:testnet": "node scripts/deploy-soulkin-cross.mjs",
    "life:check:market": "node scripts/deploy-soul-market.mjs --check",
    "life:deploy:market:testnet": "node scripts/deploy-soul-market.mjs",
    "life:check:renderer": "node scripts/propose-soul-renderer.mjs --check",
    "life:propose:renderer:mainnet": "node scripts/propose-soul-renderer.mjs",
    "life:activate:renderer:mainnet": "node scripts/propose-soul-renderer.mjs --activate",
    "flap:prepare": "node scripts/flap-launch.mjs",
    "format": "prettier --write src tests scripts server index.html README.md DESIGN.md docs"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "vite": "6.4.2"
  }
}
